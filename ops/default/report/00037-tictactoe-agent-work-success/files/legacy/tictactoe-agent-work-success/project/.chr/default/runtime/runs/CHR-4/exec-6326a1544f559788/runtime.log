+func TestRunDraw(t *testing.T) {
+	status, stdout, stderr := runScript(nil, "1\n2\n3\n5\n4\n6\n8\n7\n9\n")
+
+	if status != 0 {
+		t.Fatalf("run() status = %d, want 0", status)
+	}
+
+	if stderr != "" {
+		t.Fatalf("stderr = %q, want empty", stderr)
+	}
+
+	finalBoard := " X | O | X \n" +
+		"---+---+---\n" +
+		" X | O | O \n" +
+		"---+---+---\n" +
