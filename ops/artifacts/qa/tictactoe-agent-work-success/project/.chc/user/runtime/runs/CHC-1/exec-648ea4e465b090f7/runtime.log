+		{3, 4, 5},
+		{6, 7, 8},
+		{0, 3, 6},
+		{1, 4, 7},
+		{2, 5, 8},
+		{0, 4, 8},
+		{2, 4, 6},
+	}
+
+	for _, line := range lines {
+		mark := b.cells[line[0]]
+		if mark != Empty && mark == b.cells[line[1]] && mark == b.cells[line[2]] {
+			return mark, true
+		}
+	}
+
 	return Empty, false
 }
 
