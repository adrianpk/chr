+
+			if got != test.want {
+				t.Fatalf("Winner mark = %q, want %q", got, test.want)
+			}
+
+			if gotWin != test.wantWin {
+				t.Fatalf("Winner ok = %t, want %t", gotWin, test.wantWin)
+			}
+		})
+	}
