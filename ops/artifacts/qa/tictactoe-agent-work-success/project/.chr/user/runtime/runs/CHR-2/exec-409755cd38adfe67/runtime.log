diff --git a/internal/game/game.go b/internal/game/game.go
index 78bc222866526b2eefe0fef7f30b24cfbb00bd15..2ff696875d738f909b3044ee83e19d5ff29a8acc
--- a/internal/game/game.go
+++ b/internal/game/game.go
@@ -14,14 +14,37 @@
 	O     Mark = "O"
 )
 
+type Outcome int
+
+const (
+	OutcomeInProgress Outcome = iota
+	OutcomeXWon
+	OutcomeOWon
+	OutcomeDraw
+)
+
 type Board struct {
 	cells [9]Mark
 }
 
+type Game struct {
+	board         Board
+	currentPlayer Mark
+	outcome       Outcome
+}
+
 func NewBoard() Board {
 	return Board{}
 }
 
+func NewGame() Game {
+	return Game{
+		board:         NewBoard(),
+		currentPlayer: X,
+		outcome:       OutcomeInProgress,
+	}
+}
+
 func ParsePosition(input string) (int, error) {
 	value, err := strconv.Atoi(strings.TrimSpace(input))
 	if err != nil {
@@ -35,6 +58,71 @@
 	return value - 1, nil
 }
 
+func (g Game) Board() Board {
+	return g.board
+}
+
+func (g Game) CurrentPlayer() Mark {
+	return g.currentPlayer
+}
+
+func (g Game) Outcome() Outcome {
+	return g.outcome
+}
+
+func (g Game) Over() bool {
+	return g.outcome != OutcomeInProgress
+}
+
+func (g Game) Draw() bool {
+	return g.outcome == OutcomeDraw
+}
+
+func (g Game) Winner() (Mark, bool) {
+	switch g.outcome {
+	case OutcomeXWon:
+		return X, true
+	case OutcomeOWon:
+		return O, true
+	default:
+		return Empty, false
+	}
+}
+
+func (g Game) Play(index int) (Game, error) {
+	return g.ApplyMove(index, g.currentPlayer)
+}
+
+func (g Game) ApplyMove(index int, mark Mark) (Game, error) {
+	if g.Over() {
+		return g, fmt.Errorf("game is already over")
+	}
+
+	if mark != X && mark != O {
+		return g, fmt.Errorf("mark must be X or O")
+	}
+
+	if mark != g.currentPlayer {
+		return g, fmt.Errorf("it is %s's turn", g.currentPlayer)
+	}
+
+	board, err := g.board.Place(index, mark)
+	if err != nil {
+		return g, err
+	}
+
+	next := Game{
+		board:         board,
+		currentPlayer: mark,
+		outcome:       outcomeForBoard(board),
+	}
+	if next.outcome == OutcomeInProgress {
+		next.currentPlayer = nextPlayer(mark)
+	}
+
+	return next, nil
+}
+
 func (b Board) At(index int) (Mark, error) {
 	if index < 0 || index >= len(b.cells) {
 		return Empty, fmt.Errorf("cell index out of range")
@@ -92,3 +180,29 @@
 
 	return true
 }
+
+func outcomeForBoard(board Board) Outcome {
+	winner, ok := board.Winner()
+	if ok {
+		switch winner {
+		case X:
+			return OutcomeXWon
+		case O:
+			return OutcomeOWon
+		}
+	}
+
+	if board.Full() {
+		return OutcomeDraw
+	}
+
+	return OutcomeInProgress
+}
+
+func nextPlayer(mark Mark) Mark {
+	if mark == X {
+		return O
+	}
+
+	return X
+}

