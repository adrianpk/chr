+		{name: "unknown mark", game: NewGame(), index: 0, mark: Mark("Z")},
+		{name: "mark out of turn", game: NewGame(), index: 0, mark: O},
+		{name: "occupied cell", game: gameWithOccupiedCell, index: 0, mark: O},
