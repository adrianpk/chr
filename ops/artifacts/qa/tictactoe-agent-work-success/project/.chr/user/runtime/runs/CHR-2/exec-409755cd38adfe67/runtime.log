+		case O:
+			return OutcomeOWon
+		}
+	}
+
+	if board.Full() {
+		return OutcomeDraw
+	}
+
+	return OutcomeInProgress
+}
+
+func nextPlayer(mark Mark) Mark {
+	if mark == X {
+		return O
+	}
+
+	return X
